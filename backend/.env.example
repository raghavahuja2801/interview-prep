# MongoDB connection string (defaults to localhost for dev/seed via port-forward)
MONGO_URI=mongodb://admin:Raghav3214!@localhost:27017/interview-prep?authSource=admin

# Port the API server listens on
PORT=4000

# Postgres connection for auth/session storage
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/interview_prep

# CORS origin(s) allowed to send authenticated requests
CORS_ORIGIN=http://localhost:5173,http://interview.lab

# Admin key used to mint invite codes during local/admin setup
AUTH_ADMIN_KEY=change-me

# Set to true when cookies must be marked secure (TLS / ingress)
AUTH_COOKIE_SECURE=false

# DeepSeek API key for the AI interviewer
# Get yours at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Notion API token + database ID for syncing completed interviews
# Get a token at https://www.notion.so/my-integrations
NOTION_API_TOKEN=ntn_your_notion_token
NOTION_DATABASE_ID=your_database_uuid
