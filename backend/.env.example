# MongoDB connection string (defaults to localhost for dev/seed via port-forward)
MONGO_URI=mongodb://admin:Raghav3214!@localhost:27017/interview-prep?authSource=admin

# Port the API server listens on
PORT=4000

# DeepSeek API key for the AI interviewer
# Get yours at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Notion API token + database ID for syncing completed interviews
# Get a token at https://www.notion.so/my-integrations
NOTION_API_TOKEN=ntn_your_notion_token
NOTION_DATABASE_ID=your_database_uuid
